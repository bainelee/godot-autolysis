+func _inject(event: InputEvent) -> void:
+	var context: Dictionary = {}
+	if trace_input and (event is InputEventMouseMotion or event is InputEventMouseButton):
+		context["注入前"] = _input_context()
+		context["事件坐标"] = str(event.position)
+		if event is InputEventMouseMotion:
+			context["事件相对量"] = str(event.relative)
+	injection_depth += 1
 	Input.parse_input_event(event)
 	Input.flush_buffered_events()
+	injection_depth -= 1
+	if not context.is_empty():
+		context["注入后"] = _input_context()
+		injection_contexts.append(context)
+
+
+func _record_received_input(event: InputEvent) -> void:
+	if not event is InputEventMouseMotion and not event is InputEventMouseButton:
+		return
+	var record: Dictionary = _input_context()
+	record["注入调用内分发"] = injection_depth > 0
+	record["接收种类"] = "移动" if event is InputEventMouseMotion else "按钮"
+	record["接收坐标"] = str(event.position)
+	record["接收全局坐标"] = str(event.global_position)
+	if event is InputEventMouseMotion:
+		record["接收相对位移"] = str(event.relative)
+		record["接收屏幕位移"] = str(event.screen_relative)
+	else:
+		record["按钮编号"] = event.button_index
+		record["按下"] = event.pressed
+	received_inputs.append(record)
+
+
+func _input_context() -> Dictionary:
+	var record: Dictionary = {"分段": sequence, "物理帧": Engine.get_physics_frames(), "窗口有焦点": root.has_focus(), "窗口不可聚焦": root.unfocusable, "实际视口指针": str(root.get_mouse_position()), "合成基准": str(cursor)}
+	if is_instance_valid(handle):
+		record["拉杆高度"] = handle.position.y
+	if is_instance_valid(player) and is_instance_valid(player.interaction_controller):
+		var controller: AutolysisInteractionController = player.interaction_controller
+		record["绑定有效"] = controller.is_drag_active()
+		record["待定位消息"] = controller.get("_warp_pending")
+		record["定位原点"] = str(controller.get("_warp_origin"))
+		record["定位落点"] = str(controller.get("_warp_destination"))
+		record["定位位移"] = str(controller.get("_warp_delta"))
+	return record
+
+
+func _record_input_context() -> void:
+	if not is_instance_valid(player) or not is_instance_valid(player.interaction_controller):
+		return
+	var record: Dictionary = _input_context()
+	if not record.get("绑定有效", false) and not record.get("待定位消息", false):
+		return
+	input_contexts.append(record)
+	var signature: String = "%d/%s/%s" % [player.interaction_controller.get_instance_id(), record.get("定位原点", ""), record.get("定位落点", "")]
+	if record.get("定位落点", "(0.0, 0.0)") != "(0.0, 0.0)" and signature != last_warp_signature:
+		warp_observations.append(record.duplicate())
+		last_warp_signature = signature
 
 
