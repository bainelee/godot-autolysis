+
+func _immediate_release_callback() -> void:
+	callback_calls += 1
+	match callback_case:
+		&"slot":
+			_retire_active_node(slot)
+		&"board":
+			board.free()
+		&"player":
+			player.free()
+		&"presenter":
+			player.held_item_presenter.free()
+		&"inventory":
+			_retire_active_node(inventory)
