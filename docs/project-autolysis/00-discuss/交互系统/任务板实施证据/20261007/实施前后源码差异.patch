+## 任务板保存原逐件资源；只读许可不建立候选、占用或通知。
+func can_place_in_quest_board_slot(actor: Node3D, slot: AutolysisQuestBoardSlot) -> bool:
+	if (_busy and not _publishing) or not _quest_board_actor_valid(actor, slot) or not slot.can_transfer(actor, _publishing):
+		return false
+	var instance: AutolysisItemInstance = get_focused_instance()
+	return _quest_board_instance_valid(instance) and slot.get_stored_instance() == null
+
+
+func try_place_in_quest_board_slot(actor: Node3D, slot: AutolysisQuestBoardSlot) -> bool:
+	if _busy or not can_place_in_quest_board_slot(actor, slot):
+		return false
+	return _try_quest_board_transfer(actor, slot, true)
+
+
+func can_take_from_quest_board_slot(actor: Node3D, slot: AutolysisQuestBoardSlot) -> bool:
+	if (_busy and not _publishing) or not _quest_board_actor_valid(actor, slot) or not slot.can_transfer(actor, _publishing) or get_focused_instance() != null:
+		return false
+	var instance: AutolysisItemInstance = slot.get_stored_instance()
+	if not _quest_board_instance_valid(instance) or _slots.has(instance):
+		return false
+	var display: Node3D = slot.get_display()
+	# 资源登记是来源；缺失纸面不把占用误判为空，也不阻止取回。
+	return display == null or (display.get_parent() == slot.get_anchor() and AutolysisQuestPaperVisual.get_instance(display) == instance)
+
+
+func try_take_from_quest_board_slot(actor: Node3D, slot: AutolysisQuestBoardSlot) -> bool:
+	if _busy or not can_take_from_quest_board_slot(actor, slot):
+		return false
+	return _try_quest_board_transfer(actor, slot, false)
+
+
+func _quest_board_actor_valid(actor: Variant, slot: Variant) -> bool:
+	if not _quest_actor_valid(actor) or not actor.is_focus_business_allowed() or not _node_is_live(slot) or not slot is AutolysisQuestBoardSlot:
+		return false
+	var descriptor: AutolysisFocusTarget = actor.focus_controller.get_focus_target()
+	var board: Variant = slot.get_board()
+	return _node_is_live(board) and board is AutolysisQuestBoard and board.is_actor_focused(actor) and _node_is_live(descriptor) and descriptor == slot.get_focus_target() and descriptor.device_root == board and descriptor.get_quest_board_slot_for_target(slot) == slot
+
+
+static func _quest_board_instance_valid(instance: Variant) -> bool:
+	return is_instance_valid(instance) and instance is AutolysisItemInstance and instance.is_valid_instance() and instance.is_quest_paper()
+
+
+static func _quest_board_contents_match(instance: AutolysisItemInstance, snapshot: AutolysisQuestPaperContents) -> bool:
+	var current: AutolysisQuestPaperContents = instance.quest_paper_contents
+	if current == null or snapshot == null:
+		return current == snapshot
+	return current.get_task_id() == snapshot.get_task_id() and current.get_data_lines() == snapshot.get_data_lines() and current.get_group_gap_before_lines() == snapshot.get_group_gap_before_lines()
+
+
+func _try_quest_board_transfer(actor: Node3D, slot: AutolysisQuestBoardSlot, placing: bool) -> bool:
+	var instance: AutolysisItemInstance = get_focused_instance() if placing else slot.get_stored_instance()
+	var context: Dictionary = {
+		"inventory": self, "actor": actor, "slot": slot, "placing": placing,
+		"board": slot.get_board(), "anchor": slot.get_anchor(),
+		"focus": actor.focus_controller, "descriptor": actor.focus_controller.get_focus_target(),
+		"session": actor.focus_controller.session_id, "index": _focused_index,
+		"revision": _holding_revision, "slot_revision": slot.get_revision(),
+		"instance": instance, "definition": instance.definition, "contents": instance.quest_paper_contents,
+		"presenter": _presenter, "source_display": slot.get_display(),
+		"token": 0, "inventory_staged": false, "source_staged": false,
+		"replacement_started": false, "finalized": false,
+	}
+	_busy = true
+	context["token"] = slot.begin_transfer(actor, self)
+	if not _node_is_live(self) or context["token"] <= 0 or not _quest_board_context_valid(context, false):
+		AutolysisInventoryController._rollback_quest_board_transfer(context, null)
+		return false
+	var presenter: AutolysisHeldItemPresenter = context["presenter"]
+	context["replacement_started"] = presenter.begin_replacement(actor, self, slot, context["token"])
+	if not _node_is_live(self) or not context["replacement_started"] or not _quest_board_context_valid(context, false):
+		AutolysisInventoryController._rollback_quest_board_transfer(context, null)
+		return false
+	var visual: Node3D = slot.prepare_visual(instance) if placing else _prepare_visual(instance)
+	if not _node_is_live(self) or not is_instance_valid(visual) or visual.is_queued_for_deletion() or visual.get_parent() != null or not _quest_board_context_valid(context, false):
+		AutolysisInventoryController._rollback_quest_board_transfer(context, visual)
+		return false
+	if placing:
+		if not slot.attach_prepared_visual(actor, self, context["token"], visual, instance) or not _node_is_live(self) or not _quest_board_context_valid(context, false):
+			AutolysisInventoryController._rollback_quest_board_transfer(context, visual)
+			return false
+		if not _node_is_live(visual) or visual.get_parent() != context["anchor"] or AutolysisQuestPaperVisual.get_instance(visual) != instance:
+			AutolysisInventoryController._rollback_quest_board_transfer(context, visual)
+			return false
+		context["source_staged"] = slot.stage_place(actor, self, context["token"], visual, instance)
+	else:
+		context["source_staged"] = slot.stage_take(actor, self, context["token"], instance)
+	if not _node_is_live(self) or not context["source_staged"]:
+		AutolysisInventoryController._rollback_quest_board_transfer(context, visual)
+		return false
+	# 暂存不发通知且不增加修订；所有展示回调后仍能按本次身份撤回。
+	_slots[context["index"]] = null if placing else instance
+	context["inventory_staged"] = true
+	var held_visual: Node3D = null if placing else visual
+	var held_instance: AutolysisItemInstance = null if placing else instance
+	if not presenter.stage_replacement(actor, self, slot, context["token"], held_visual, held_instance) or not _node_is_live(self) or not _quest_board_context_valid(context, true):
+		AutolysisInventoryController._rollback_quest_board_transfer(context, visual)
+		return false
+	if placing:
+		if not _node_is_live(visual) or visual.get_parent() != context["anchor"] or slot.get_display() != visual or AutolysisQuestPaperVisual.get_instance(visual) != instance:
+			AutolysisInventoryController._rollback_quest_board_transfer(context, visual)
+			return false
+	elif not _node_is_live(visual) or visual.get_parent() != presenter or presenter.get_display() != visual or AutolysisQuestPaperVisual.get_instance(visual) != instance:
+		AutolysisInventoryController._rollback_quest_board_transfer(context, visual)
+		return false
+	if not slot.can_finalize_transfer(actor, self, context["token"]) or not presenter.can_finalize_replacement(actor, self, slot, context["token"]):
+		AutolysisInventoryController._rollback_quest_board_transfer(context, visual)
+		return false
+	# 预检与两方最终字段提交之间没有外部回调，构成同一同步提交点。
+	slot.finalize_transfer(actor, self, context["token"])
+	presenter.finalize_replacement(actor, self, slot, context["token"])
+	context["finalized"] = true
+	_holding_revision += 1
+	AutolysisInventoryController._finish_quest_board_transfer(context)
+	return true
+
+
+func _quest_board_context_valid(context: Dictionary, staged: bool) -> bool:
+	var actor: Variant = context["actor"]
+	var slot: Variant = context["slot"]
+	if not _node_is_live(self) or not _quest_board_actor_valid(actor, slot) or _presenter != context["presenter"]:
+		return false
+	var expected_held: Variant = context["instance"] if context["placing"] != staged else null
+	if _focused_index != context["index"] or _holding_revision != context["revision"] or get_focused_instance() != expected_held:
+		return false
+	var focus: Variant = context["focus"]
+	var descriptor: Variant = context["descriptor"]
+	if not _node_is_live(focus) or actor.focus_controller != focus or focus.session_id != context["session"] or not _node_is_live(descriptor) or focus.get_focus_target() != descriptor or not focus.is_focused_on(descriptor):
+		return false
+	var instance: Variant = context["instance"]
+	if not _quest_board_instance_valid(instance) or instance.definition != context["definition"] or not _quest_board_contents_match(instance, context["contents"]):
+		return false
+	if slot.get_board() != context["board"] or slot.get_anchor() != context["anchor"] or not _node_is_live(context["anchor"]) or slot.get_revision() != context["slot_revision"] or not slot.is_transfer_current(actor, self, context["token"]):
+		return false
+	var expected_stored: Variant = context["instance"] if context["placing"] == staged else null
+	if slot.get_stored_instance() != expected_stored:
+		return false
+	if not context["placing"]:
+		var source: Variant = context["source_display"]
+		# 原显示可被释放；仍存活的来源必须继续匹配原件与锚点。
+		if _node_is_live(source) and (source.get_parent() != context["anchor"] or AutolysisQuestPaperVisual.get_instance(source) != instance):
+			return false
+	return true
+
+
+static func _rollback_quest_board_transfer(context: Dictionary, visual: Variant) -> void:
+	if context["finalized"]:
+		return
+	var inventory: Variant = context["inventory"]
+	var actor: Variant = context["actor"]
+	var slot: Variant = context["slot"]
+	var presenter: Variant = context["presenter"]
+	var token: int = context["token"]
+	if is_instance_valid(inventory) and context["inventory_staged"]:
+		var expected: Variant = null if context["placing"] else context["instance"]
+		if inventory.get_slot_instance(context["index"]) == expected:
+			inventory._slots[context["index"]] = context["instance"] if context["placing"] else null
+	if is_instance_valid(presenter) and context["replacement_started"]:
+		presenter.rollback_replacement(actor, inventory, slot, token)
+	if is_instance_valid(slot) and token > 0:
+		slot.rollback_transfer(actor, inventory, token)
+	# 候选只能属于本次请求；释放后不再访问父级或成员。
+	if is_instance_valid(visual) and visual is Node and not visual.is_queued_for_deletion():
+		if visual.is_inside_tree():
+			visual.queue_free()
+		else:
+			visual.free()
+	if is_instance_valid(presenter) and context["replacement_started"]:
+		presenter.end_replacement(actor, inventory, slot, token)
+	if is_instance_valid(slot) and token > 0:
+		slot.end_transfer(actor, inventory, token)
+	if is_instance_valid(inventory):
+		inventory._busy = inventory._publication_depth > 0
+
+
+static func _finish_quest_board_transfer(context: Dictionary) -> void:
+	var inventory: Variant = context["inventory"]
+	var actor: Variant = context["actor"]
+	var slot: Variant = context["slot"]
+	var presenter: Variant = context["presenter"]
+	var token: int = context["token"]
+	# 已完成转移后，清理或通知中的失效不能撤销已提交资源。
+	if is_instance_valid(presenter):
+		presenter.cleanup_replacement(actor, inventory, slot, token)
+	if is_instance_valid(slot):
+		slot.cleanup_transfer(actor, inventory, token)
+	if _node_is_live(inventory):
+		inventory._publication_depth += 1
+		inventory._publishing = true
+		inventory.inventory_changed.emit()
+		if _node_is_live(inventory):
+			inventory.held_item_changed.emit()
+	if _node_is_live(slot):
+		slot.notify_transfer(actor, inventory, token)
+	if is_instance_valid(presenter):
+		presenter.end_replacement(actor, inventory, slot, token)
+	if is_instance_valid(slot):
+		slot.end_transfer(actor, inventory, token)
+	if is_instance_valid(inventory):
+		if inventory._publishing:
+			inventory._publication_depth -= 1
+		inventory._publishing = inventory._publication_depth > 0
+		inventory._busy = inventory._publication_depth > 0
+
