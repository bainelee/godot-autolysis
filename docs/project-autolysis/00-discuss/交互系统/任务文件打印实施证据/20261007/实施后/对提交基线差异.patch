+	return _node_is_live(descriptor) and descriptor.device_root == machine and descriptor.owns_target(paper) and machine.can_release_completed_paper(actor, paper, paper.get_print_serial(), instance)
+
+
+func try_take_quest_paper(actor: Node3D, paper: AutolysisQuestPaper) -> bool:
+	if _busy or not can_take_quest_paper(actor, paper):
+		return false
+	var context: Dictionary = {
+		"inventory": self,
+		"actor": actor,
+		"focus": actor.focus_controller,
+		"descriptor": actor.focus_controller.get_focus_target(),
+		"session": actor.focus_controller.session_id,
+		"index": _focused_index,
+		"revision": _holding_revision,
+		"machine": paper.get_machine(),
+		"paper": paper,
+		"serial": paper.get_print_serial(),
+		"instance": paper.get_item_instance(),
+		"presenter": _presenter,
+		"token": 0,
+	}
+	_busy = true
+	context["token"] = context["machine"].begin_paper_take(actor, paper, context["serial"], context["instance"])
+	if not is_instance_valid(self):
+		AutolysisInventoryController._rollback_quest_paper_take(context, null)
+		return false
+	if context["token"] <= 0 or not _quest_take_context_valid(context, false):
+		AutolysisInventoryController._rollback_quest_paper_take(context, null)
+		return false
+	var visual: Node3D = _prepare_visual(context["instance"])
+	if not is_instance_valid(self):
+		AutolysisInventoryController._rollback_quest_paper_take(context, visual)
+		return false
+	if not is_instance_valid(visual) or visual.is_queued_for_deletion() or visual.get_parent() != null or not _quest_take_context_valid(context, false):
+		AutolysisInventoryController._rollback_quest_paper_take(context, visual)
+		return false
+	# 来源撤销先保留可匹配的回滚记录；全部展示边界通过后才清理纸张或通知。
+	var source_committed: bool = context["machine"].commit_paper_take(actor, paper, context["serial"], context["instance"], context["token"])
+	if not is_instance_valid(self):
+		AutolysisInventoryController._rollback_quest_paper_take(context, visual)
+		return false
+	if not source_committed or not _quest_take_context_valid(context, false):
+		AutolysisInventoryController._rollback_quest_paper_take(context, visual)
+		return false
+	_slots[context["index"]] = context["instance"]
+	_commit_visual(visual)
+	if not is_instance_valid(self):
+		AutolysisInventoryController._rollback_quest_paper_take(context, visual)
+		return false
+	if not _quest_take_context_valid(context, true) or not _node_is_live(visual) or _presenter.get_display() != visual or visual.get_parent() != _presenter:
+		AutolysisInventoryController._rollback_quest_paper_take(context, visual)
+		return false
+	# 从此处起双方提交已成功；观察者的释放或重入不能撤销这件已取得的资源。
+	var take_finished: bool = context["machine"].finish_paper_take(actor, paper, context["serial"], context["instance"], context["token"])
+	if not take_finished:
+		AutolysisInventoryController._rollback_quest_paper_take(context, visual)
+		return false
+	if _node_is_live(self):
+		_publish_change()
+	var machine: Variant = context["machine"]
+	if _node_is_live(machine) and machine is AutolysisQuestMachine:
+		machine.abort_paper_take(context["token"])
+	return true
+
+
+func _quest_actor_valid(actor: Variant) -> bool:
+	return _ordinary_hands_available() and _dependencies_valid() and _node_is_live(actor) and actor is AutolysisPlayer and actor.get_node_or_null("InventoryController") == self and actor.is_focus_input_allowed() and _node_is_live(actor.focus_controller)
+
+
+func _quest_take_context_valid(context: Dictionary, inventory_committed: bool) -> bool:
+	if not _node_is_live(self) or not _quest_actor_valid(context["actor"]) or _presenter != context["presenter"]:
+		return false
+	if _focused_index != context["index"] or _holding_revision != context["revision"] or get_focused_instance() != (context["instance"] if inventory_committed else null):
+		return false
+	var actor: AutolysisPlayer = context["actor"]
+	var focus: Variant = context["focus"]
+	var descriptor: Variant = context["descriptor"]
+	if not _node_is_live(focus) or actor.focus_controller != focus or focus.session_id != context["session"] or not _node_is_live(descriptor) or focus.get_focus_target() != descriptor or not focus.is_focused_on(descriptor):
+		return false
+	var machine: Variant = context["machine"]
+	var paper: Variant = context["paper"]
+	var instance: Variant = context["instance"]
+	if not _node_is_live(machine) or not machine is AutolysisQuestMachine or not _node_is_live(paper) or not paper is AutolysisQuestPaper or not is_instance_valid(instance) or not instance is AutolysisItemInstance or not instance.is_valid_instance() or not instance.is_quest_paper():
+		return false
+	if descriptor.device_root != machine or not paper.matches_source(machine, context["serial"], instance):
+		return false
+	return machine.validate_paper_take(actor, paper, context["serial"], instance, context["token"])
+
+
+## 回滚可在玩家或设备释放后执行；只撤回此次匹配的格、展示与来源锁。
+static func _rollback_quest_paper_take(context: Dictionary, visual: Variant) -> void:
+	var inventory: Variant = context["inventory"]
+	var presenter: Variant = context["presenter"]
+	var machine: Variant = context["machine"]
+	if is_instance_valid(inventory) and inventory is AutolysisInventoryController:
+		if inventory.get_slot_instance(context["index"]) == context["instance"]:
+			inventory._slots[context["index"]] = null
+	if _node_is_live(presenter) and presenter is AutolysisHeldItemPresenter:
+		if visual != null and presenter._display == visual:
+			presenter.commit_prepared(null)
+		if _node_is_live(presenter) and presenter._instance == context["instance"]:
+			presenter.watch_instance(null)
+	if is_instance_valid(visual) and visual is Node and not visual.is_queued_for_deletion():
+		if visual.is_inside_tree():
+			visual.queue_free()
+		else:
+			visual.free()
+	if _node_is_live(machine) and machine is AutolysisQuestMachine and context["token"] > 0:
+		machine.rollback_paper_take(context["actor"], context["paper"], context["serial"], context["instance"], context["token"])
+		if _node_is_live(machine):
+			machine.abort_paper_take(context["token"])
+	if is_instance_valid(inventory) and inventory is AutolysisInventoryController:
+		inventory._busy = false
