+## 任务文件有独立来源合同，不进入世界原料或其他设备取出分支。
+func can_take_quest_paper(actor: Node3D, paper: AutolysisQuestPaper) -> bool:
+	if (_busy and not _publishing) or not _quest_actor_valid(actor) or not _node_is_live(paper) or get_focused_instance() != null:
+		return false
+	var machine: Variant = paper.get_machine()
