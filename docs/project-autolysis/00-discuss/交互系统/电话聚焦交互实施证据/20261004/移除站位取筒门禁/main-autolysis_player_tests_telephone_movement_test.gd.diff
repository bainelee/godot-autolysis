+func _actor_bounds_in_limit() -> AABB:
+	var bounds: AABB
+	var first: bool = true
+	for collision: CollisionShape3D in [actor.standing_collision_shape, actor.crouching_collision_shape]:
+		if collision.disabled:
+			continue
+		var half_size: Vector3 = (collision.shape as BoxShape3D).size * 0.5
+		var relative: Transform3D = telephone.move_limit_shape.global_transform.affine_inverse() * collision.global_transform
+		for x: float in [-half_size.x, half_size.x]:
+			for y: float in [-half_size.y, half_size.y]:
+				for z: float in [-half_size.z, half_size.z]:
+					var point: Vector3 = relative * Vector3(x, y, z)
+					bounds = AABB(point, Vector3.ZERO) if first else bounds.expand(point)
+					first = false
+	return bounds
+
+
+func _actor_penetrates_limit() -> bool:
+	# 缩小独立查询盒只排除接触面容差，不改玩家或限位的共享形状。
+	for collision: CollisionShape3D in [actor.standing_collision_shape, actor.crouching_collision_shape]:
+		if collision.disabled:
+			continue
+		var query_shape: BoxShape3D = BoxShape3D.new()
+		query_shape.size = (collision.shape as BoxShape3D).size - Vector3.ONE * GEOMETRY_TOLERANCE * 2.0
+		var query: PhysicsShapeQueryParameters3D = PhysicsShapeQueryParameters3D.new()
+		query.shape = query_shape
+		query.transform = collision.global_transform
+		query.collision_mask = telephone.move_limit_body.collision_layer
+		for hit: Dictionary in actor.get_world_3d().direct_space_state.intersect_shape(query, 64):
+			if hit.get("collider") == telephone.move_limit_body:
+				return true
+	return false
+
+
+func _limit_probe_start() -> Vector3:
+	var root_local: Vector3 = telephone.move_limit_shape.to_local(actor.global_position)
+	var footprint: AABB = _actor_bounds_in_limit()
+	var local: Vector3 = telephone.move_limit_shape.to_local(origin)
+	local.x = (telephone.move_limit_shape.shape as BoxShape3D).size.x * 0.5 + root_local.x - footprint.position.x + PROBE_CLEARANCE
+	local.z = 0.0
+	return telephone.move_limit_shape.to_global(local)
+
+
