+	asset_measurements = {"限位形状路径": str(telephone.move_limit_shape.get_path()), "限位盒尺寸": str((telephone.move_limit_shape.shape as BoxShape3D).size), "限位相对电话变换": str(telephone.global_transform.affine_inverse() * telephone.move_limit_shape.global_transform), "限位全局变换": str(telephone.move_limit_shape.global_transform), "初始玩家实际足迹": str(_actor_bounds_in_limit()), "几何接触容差": GEOMETRY_TOLERANCE, "探针与盒面的初始及终点净距": PROBE_CLEARANCE, "固定墙": []}
+	for path: String in ["Environment/wall/wall_room0_24/CollisionShape3D", "Environment/wall/wall_room0_25/CollisionShape3D", "Environment/wall/wall_room0_8/CollisionShape3D"]:
+		var collision: CollisionShape3D = world.get_node(path) as CollisionShape3D
+		var bounds: AABB
+		var first: bool = true
+		for point: Vector3 in (collision.shape as ConcavePolygonShape3D).get_faces():
+			var world_point: Vector3 = collision.global_transform * point
+			bounds = AABB(world_point, Vector3.ZERO) if first else bounds.expand(world_point)
+			first = false
+		asset_measurements["固定墙"].append({"物理来源": str(collision.get_parent().get_path()), "实际顶点全局包围盒": str(bounds)})
